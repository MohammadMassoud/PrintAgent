<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../build/NuGetPackage.props" />
  <PropertyGroup>
    <PackageId>SinergiaPrint.Server</PackageId>
    <Description>Embed the SinergiaPrint API in an ASP.NET Core backend. Includes a persistent SQLite print queue, token-authenticated Windows agent endpoints, and a contextual installer with expiring single-use enrollment.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../SinergiaPrint.Contracts/SinergiaPrint.Contracts.csproj" />
    <ProjectReference Include="../SinergiaPrint.Bootstrap/SinergiaPrint.Bootstrap.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <EmbeddedResource Include="../SinergiaPrint.Bootstrap/bin/$(Configuration)/net48/SinergiaPrint.Bootstrap.exe" LogicalName="SinergiaPrint.Bootstrap.exe" />
  </ItemGroup>
</Project>
