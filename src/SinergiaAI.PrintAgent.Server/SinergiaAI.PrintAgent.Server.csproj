<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../build/NuGetPackage.props" />
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Legacy backend APIs remain available; the current SinergiaAI.PrintAgent facade is fully documented. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>SinergiaAI.PrintAgent</PackageId>
    <Title>PrintAgent by SinergiaAI - RAW printing bridge for Blazor and .NET</Title>
    <Description>Open-source RAW printing middleware for Blazor Server and .NET 10. Send text commands with SendAsync or exact bytes with SendByteAsync to Windows queues, shared network printers and TCP destinations. Supports label, receipt and ordinary-paper printers that accept the supplied language, including ZPL, ESC/POS, PCL and PostScript. Browser-to-agent WebSocket bridge, durable local queue and idempotent request keys. No PDF, HTML or image rendering.</Description>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludePrintAgentLibraries</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="Blazor/print-agent.js" LogicalName="PrintAgent.Browser.js" />
    <ProjectReference Include="../SinergiaAI.PrintAgent.Contracts/SinergiaAI.PrintAgent.Contracts.csproj" PrivateAssets="all" />
    <ProjectReference Include="../SinergiaAI.PrintAgent.Client/SinergiaAI.PrintAgent.Client.csproj" PrivateAssets="all" />
    <ProjectReference Include="../SinergiaAI.PrintAgent.Bootstrap/SinergiaAI.PrintAgent.Bootstrap.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <EmbeddedResource Include="../SinergiaAI.PrintAgent.Bootstrap/bin/$(Configuration)/net48/SinergiaAI.PrintAgent.Bootstrap.exe" LogicalName="SinergiaAI.PrintAgent.Bootstrap.exe" />
  </ItemGroup>
  <!-- Package the existing assemblies without publishing internal project dependencies. -->
  <Target Name="IncludePrintAgentLibraries" DependsOnTargets="BuildOnlySettings">
    <ItemGroup>
      <BuildOutputInPackage Include="$(TargetDir)SinergiaAI.PrintAgent.Client.dll" />
      <BuildOutputInPackage Include="$(TargetDir)SinergiaAI.PrintAgent.Contracts.dll" />
    </ItemGroup>
  </Target>
</Project>
