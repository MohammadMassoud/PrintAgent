<Project>
  <Import Project="Version.props" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Authors>MohammadMassoud</Authors>
    <Company>SinergiaAI</Company>
    <PackageProjectUrl>https://www.sinergiaai.com/printagent</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MohammadMassoud/PrintAgent.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>sinergia.png</PackageIcon>
    <PackageTags>printing;printagent;middleware;blazor;blazor-server;dotnet;csharp;label-printing;thermal-printer;network-printer;raw;zpl;escpos;pcl;postscript;websocket;windows;tcp;sinergiaai</PackageTags>
    <PackageReleaseNotes>2.0.0: SendAsync now accepts text with configurable strict encoding; use SendByteAsync for existing byte-array calls. CreateTextDocument prepares mixed text/binary batches. English XML API documentation is included for IntelliSense and metadata navigation. Windows agent discovers shared printers from active user sessions and selects their delivery identity without retrying uncertain writes. RAW printing bridge for compatible label, receipt and ordinary-paper printers. Durable queue, protocol 2 and idempotency are preserved. See docs/migration-2.0.md.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../branding/sinergia.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
