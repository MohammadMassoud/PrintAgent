<Project>
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Version>1.1.0</Version>
    <Authors>MohammadMassoud</Authors>
    <Company>SinergiaAI</Company>
    <PackageProjectUrl>https://www.sinergiaai.com/printagent</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MohammadMassoud/PrintAgent.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>sinergia.png</PackageIcon>
    <PackageTags>printing;printagent;blazor;blazor-server;dotnet;csharp;label-printing;thermal-printer;receipt;barcode;raw;zpl;zebra;escpos;websocket;windows;tcp;sinergiaai</PackageTags>
    <PackageReleaseNotes>Windows tray application, Start menu shortcut, per-user desktop startup, service start/stop controls and native website authorization requested automatically by StartAsync. Desktop UI follows the Windows display language (English or Portuguese). Requires Windows agent 1.1.0. Local durable queue and idempotency are preserved. No printing API or server database required.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../branding/sinergia.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
