<Project>
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Version>0.5.0</Version>
    <Authors>MohammadMassoud</Authors>
    <Company>SinergiaAI</Company>
    <PackageProjectUrl>https://github.com/MohammadMassoud/PrintAgent</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MohammadMassoud/PrintAgent.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>printing;printagent;raw;zpl;zebra;escpos;blazor;sinergiaai</PackageTags>
    <PackageReleaseNotes>Long polling: authenticated claims wait asynchronously up to 20 seconds, notified after enqueue/ack commits without holding SQLite connections. Windows agent 0.4.0 renews idle waits immediately, falls back safely on older APIs, and reconnects with exponential backoff and jitter. Update backend and Windows agent to reduce idle requests.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
